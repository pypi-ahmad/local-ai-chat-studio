    "lucide-react": "^1.25.0",
    "mermaid": "11.16.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
