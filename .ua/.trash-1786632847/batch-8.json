    {
      "id": "document:frontend/README.md",
      "type": "document",
      "name": "README.md",
      "filePath": "frontend/README.md",
      "summary": "Frontend React workspace guide covering install with npm ci --legacy-peer-deps, Vite dev that proxies /api to 127.0.0.1:8506, and test, lint, build, and OpenAPI generation scripts. Notes that src/api/schema.ts is generated from the FastAPI OpenAPI document and that the root openapi.json artifact must not be committed.",
      "tags": ["documentation", "entry-point", "frontend", "getting-started"],
      "complexity": "simple",
      "languageNotes": "Documents npm ci --legacy-peer-deps and the Vite /api proxy to port 8506."
    },
    {
      "id": "config:frontend/package.json",
      "type": "config",
      "name": "package.json",
      "filePath": "frontend/package.json",
      "summary": "npm manifest for the React 19 + Vite frontend, defining scripts for dev, TypeScript-checked production build, oxlint, Vitest, and OpenAPI client generation. Pins TypeScript 5.9, Tailwind 4, and UI libraries, with generate:api writing src/api/schema.ts via openapi-typescript.",
      "tags": ["configuration", "build-system", "dependencies", "frontend"],
      "complexity": "simple",
      "languageNotes": "TypeScript ~5.9.3 and Vite 8; generate:api chains a Python OpenAPI export with openapi-typescript."
    },
    {
      "id": "config:frontend/tsconfig.app.json",
      "type": "config",
      "name": "tsconfig.app.json",
      "filePath": "frontend/tsconfig.app.json",
      "summary": "TypeScript 5.9 application compiler options for the frontend src tree: ES2023 plus DOM, React JSX, bundler module resolution, and @/* path aliases into ./src. Enables unused-local/parameter and switch-fallthrough checks, verbatimModuleSyntax, erasableSyntaxOnly, and noEmit so Vite owns bundling.",
      "tags": ["configuration", "typescript", "build-system", "compiler"],
      "complexity": "simple",
      "languageNotes": "TypeScript 5.9 bundler-mode config with verbatimModuleSyntax, erasableSyntaxOnly, and @/* aliases."
    }
  ],
