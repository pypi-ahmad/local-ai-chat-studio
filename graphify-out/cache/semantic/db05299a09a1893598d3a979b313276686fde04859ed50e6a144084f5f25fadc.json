l, "contributor": null}, {"id": "readme_message_actions", "label": "Message actions", "file_type": "concept", "source_file": "README.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_organize_find", "label": "Organize & find", "file_type": "concept", "source_file": "README.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_data_controls", "label": "Data controls", "file_type": "concept", "source_file": "README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_health_bar", "label": "Health bar", "file_type": "concept", "source_file": "README.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_design_note_background_jobs", "label": "Design note: Replies are background jobs", "file_type": "rationale", "source_file": "README.md", "source_location": "L227-229", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The submit handler persists the message and returns in milliseconds; a worker thread does file parsing, OCR, web search, retrieval, and streaming, so generation survives page navigation and the UI never blocks."}, {"id": "readme_design_note_zero_hardcoded_models", "label": "Design note: Zero hardcoded models", "file_type": "rationale", "source_file": "README.md", "source_location": "L230-231", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hints, vision detection, and the coding-agent model pick are all derived from live API metadata and name patterns instead of a maintained list, so new models work without code changes."}, {"id": "readme_design_note_helper_tasks_local", "label": "Design note: Helper tasks stay local", "file_type": "rationale", "source_file": "README.md", "source_location": "L232-233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Titles, memory extraction, embeddings, and OCR always use local models even when the user chats with a cloud provider, keeping ancillary/derived data off third-party servers regardless of the chosen chat provider."}, {"id": "readme_privacy_security", "label": "Privacy and Security", "file_type": "concept", "source_file": "README.md", "source_location": "L189-198", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API keys held only in server process memory for the session, never written to disk/logged/exported; trades having to re-enter keys after a restart for reduced secret-exposure surface."}, {"id": "readme_roadmap", "label": "Roadmap", "file_type": "concept", "source_file": "README.md", "source_location": "L247-253", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_document", "target": "readme_local_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L39-40", "weight": 1.0}, {"source": "readme_document", "target": "readme_zero_maintenance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L41-43", "weight": 1.0}, {"source": "readme_document", "target": "readme_it_knows_you", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L44-45", "weight": 1.0}, {"source": "readme_document", "target": "readme_long_term_memory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L51", "weight": 1.0}, {"source": "readme_document", "target": "readme_cross_chat_references", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REA