{"nodes": [{"id": "readme_document", "label": "README.md (Local AI Chat Studio)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_local_first", "label": "Local-first", "file_type": "concept", "source_file": "README.md", "source_location": "L39-40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs entirely against the user's own Ollama by default; cloud providers are opt-in per key, per session. Trades cloud-provider convenience/scale for keeping data and control on the user's machine."}, {"id": "readme_zero_maintenance", "label": "Zero-maintenance", "file_type": "concept", "source_file": "README.md", "source_location": "L41-43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every model list is discovered live at runtime instead of hardcoded, so pulling a new model or a provider shipping one needs no config edits \u2014 avoids the upkeep cost of a maintained allow-list."}, {"id": "readme_it_knows_you", "label": "It knows you", "file_type": "concept", "source_file": "README.md", "source_location": "L44-45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChatGPT-style long-term memory, cross-conversation references, and a personalization profile trade extra local processing/storage of conversation history for an assistant that improves the more the user chats."}, {"id": "readme_long_term_memory", "label": "Long-term memory", "file_type": "concept", "source_file": "README.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cross_chat_references", "label": "Cross-chat references", "file_type": "concept", "source_file": "README.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id":